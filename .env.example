# Copy to .env and fill in values. Never commit .env.
# Model access is optional: without a key the system uses the offline
# extractive generator and still processes tickets (acceptance A11).

OPENROUTER_API_KEY=
MODEL_NAME=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=all-MiniLM-L6-v2

CHROMA_PATH=./storage/chroma
DATABASE_URL=sqlite:///./storage/decisions.db
CLASSIFIER_PATH=./storage/classifier.joblib

LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.72
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.12
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_BACKEND=lexical

# Force every ticket to escalate without a redeploy (kill switch).
KILL_SWITCH=false

# FastAPI
API_HOST=0.0.0.0
API_PORT=43123
METRICS_PORT=8001
